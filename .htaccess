# ═══════════════════════════════════════════════════════════════════════════
# EMS Security Configuration - .htaccess (Simplified & Fixed)
# تكوين أمان Apache للنظام - نسخة مبسطة وآمنة
# @version 2.2 - Fixed 403 Forbidden Issue
# @date 2026-03-01
# ═══════════════════════════════════════════════════════════════════════════

# السماح بالوصول للموقع ومنع عرض محتوى المجلدات
Options -Indexes +FollowSymLinks
DirectoryIndex index.php index.html

# ═══════════════════════════════════════════════════════════════════════════
# 1. حماية الملفات الحساسة
# ═══════════════════════════════════════════════════════════════════════════

# منع الوصول لملفات .htaccess و .env وأخواتها (قائمة صريحة — لا نستخدم ^\. الشامل
# حتى لا نكسر .well-known المطلوب لتجديد شهادات SSL على الاستضافة)
<FilesMatch "^\.(htaccess|htpasswd|env|env\.example|gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# منع الوصول المباشر إلى ملفات الإعدادات الحساسة
<FilesMatch "^config.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# منع الوصول لملفات النسخ الاحتياطي وقواعد البيانات
<FilesMatch "\.(bak|backup|old|orig|save|swp|tmp|sql|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# ═══════════════════════════════════════════════════════════════════════════
# 2. Security Headers (اختياري - قد يسبب مشاكل في بعض الحالات)
# ═══════════════════════════════════════════════════════════════════════════

# معطلة حالياً - يتم تطبيقها من PHP في security.php
# <IfModule mod_headers.c>
#     Header always set X-Frame-Options "DENY"
#     Header always set X-Content-Type-Options "nosniff"
#     Header always set X-XSS-Protection "1; mode=block"
# </IfModule>

# ═══════════════════════════════════════════════════════════════════════════
# 3. تحسين الأداء (Caching)
# ═══════════════════════════════════════════════════════════════════════════

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType text/html "access plus 5 minutes"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════
# 4. Compression للأداء
# ═══════════════════════════════════════════════════════════════════════════

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════
# 5. حدُّ رفع الملفات (D05 وغيره)
#    الشاشة تعِد بـ5MB، لكن php.ini الافتراضي في WAMP = upload_max_filesize 2M،
#    فأيُّ صورةٍ بين 2 و5 ميغابايت كانت تُرفض قبل وصولها للتطبيق. نمنح الخادم
#    مساحته هنا — بنطاق هذا التطبيق وحده، وبلا إعادة تشغيل (mod_php يقرأ .htaccess
#    مع كل طلب). post_max_size أوسعُ ليتّسع للملف مع بقيّة حقول النموذج.
# ═══════════════════════════════════════════════════════════════════════════
<IfModule php_module>
    php_value upload_max_filesize 6M
    php_value post_max_size 10M
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════
# END OF .htaccess - نسخة مبسطة وآمنة
# ═══════════════════════════════════════════════════════════════════════════
