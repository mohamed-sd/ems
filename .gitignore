# ═══════════════════════════════════════════════════════════════════════════
# EMS .gitignore — أُنشئ ضمن ADR-04 (فصل الأسرار · EQUIP-ARC-R02)
# القاعدة: لا أسرار، لا سجلات، لا نسخ قاعدة بيانات في المستودع — أبدًا.
# ═══════════════════════════════════════════════════════════════════════════

# الأسرار — القالب .env.example هو الوحيد الذي يدخل المستودع
.env

# إعداد خوادم MCP — قد يحوي مفاتيح API نصًّا صريحًا
.mcp.json

# السجلات (ملفا الحماية logs/.htaccess و logs/index.php يبقيان متتبَّعين)
logs/*.log
storage/logs/*.log

# لقطات ونسخ قاعدة البيانات — ليست كودًا ولا تدخل المستودع
# (ترحيلات database/migrations/ هي الكود المعتمد وتبقى متتبَّعة)
database/baseline/
database/backups/
database/equipation_manage*.sql

# مخلفات أنظمة التشغيل وأدوات الاختبار المحلية
.ssdiff/
Thumbs.db
desktop.ini
.env.bak*

# سلامة البيئة (PLAN-05 §3-⑩): النسخ المشفَّرة وتاريخ التهيئة لا يدخلان المستودع
database/backups/secrets/
database/backups/env_history/

# المُثبِّت: علامةُ التنصيب ورمزُه خاصّان بكل خادم — لا يدخلان المستودع.
# (مصنوعاتُ database/schema/ كودٌ معتمدٌ وتبقى متتبَّعة — هي وصفةُ التنصيب.)
.installed
install/install.token
**/~$*.xlsx
