# ═══════════════════════════════════════════════════════════════════════════
# EMS REST API — توجيه كل الطلبات إلى index.php + تمرير ترويسة Authorization
# ═══════════════════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ems/api/

    # تمرير ترويسة Authorization إلى PHP (بعض إعدادات Apache تحذفها).
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # وجّه أي مسار غير ملف/مجلد فعلي إلى المتحكّم الأمامي.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# احتياط إضافي لتمرير Authorization عبر CGI/FastCGI.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# ═══ INJ-FIX-01 · الموجة أ ④ — تضييقُ منحِ الوصولِ إلى خطِّ الأساس ═══════════
# ◆ **ما كان**: `Require all granted` — ومنطوقُه «كلُّ عميلٍ في العالم».
#   وسببُه المكتوبُ «الجذرُ يمنع فهرسةَ المجلدات» — و`Require local` في
#   الجذرِ ليس منعَ فهرسةٍ بل **منعَ عميلٍ بعنوانِه**. فكان المنحُ أوسعَ من
#   غرضِه، و`AllowOverride all` يجعله ينقض الجذرَ فعلًا.
# ◆ **والأثرُ المقيس**: كلُّ أسطحِ التطبيقِ محجوبةٌ لغيرِ المحلّيِّ **إلا
#   مجلدَ الواجهةِ البرمجية** — فصار سطحُ الهجومِ الوحيدَ المفتوحَ في النظام،
#   ومعه `Access-Control-Allow-Origin: *`.
# ◆ **ولم يُقفل بيانٌ كان مفتوحًا**: القياسُ أثبت 401 في الحالاتِ الثلاث
#   (بلا رمزٍ · برمزٍ باطلٍ · برمزٍ فارغ) — فالمضيَّقُ سطحُ الوصولِ لا البيان.
# ◆ **والفتحُ قرارٌ يمرُّ ببوابةٍ لا سطرٌ يُنسى**: إن لزم تطبيقٌ جوّالٌ على
#   الشبكةِ المحلية، تُفتح المدى صراحةً أدناه بقرارٍ مسجَّلٍ — لا بـ`granted`
#   للعالم. والرجوعُ: `cp api/.htaccess.injfix01.bak api/.htaccess`.
<IfModule mod_authz_core.c>
    Require local
    # Require ip 192.168.100.0/24   ← يُفعَّل بقرارٍ مسجَّلٍ عند اعتمادِ الجوّال
</IfModule>
