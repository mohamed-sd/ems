# ═══════════════════════════════════════════════════════════════════════════
# EMS — قالب متغيرات البيئة (.env.example) · ADR-04
#
# طريقة الاستخدام: انسخ هذا الملف باسم .env في جذر المشروع واملأ القيم.
#   cp .env.example .env
# ملف .env الحقيقي لا يدخل المستودع أبدًا (محجوب في .gitignore).
# القاعدة: أي سرٍّ جديد يُضاف هنا كمفتاح موثَّق ويُقرأ بـ ems_env() —
# لا يُكتب أي سرٍّ في الكود إطلاقًا (قائمة التجميد · EQUIP-ARC-R02 §5).
# ═══════════════════════════════════════════════════════════════════════════

# ── قاعدة البيانات ──────────────────────────────────────────────────────────
# محليًا (WAMP): localhost / root / (فارغة) / equipation_manage
# على الإنتاج (Hostinger): القيم من hPanel → Databases
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# ── مستخدما القاعدة المفصولان (ADR-04 · المرحلة 0 · P0-2) ────────────────────
# ems_app: اتصال التطبيق — DML فقط (SELECT/INSERT/UPDATE/DELETE) على قاعدة EMS حصرًا.
# ems_migrator: مشغّل الترحيلات migrate.php — على قاعدة EMS حصرًا (لا *.*):
#   DML + CREATE/ALTER/DROP/INDEX/REFERENCES
#   + SHOW VIEW/CREATE VIEW (وُسّعت 2026-07-08 بموافقة صريحة — K2: لقطة المخطّط
#     في المشغّل تتطلب SHOW VIEW، وترحيلات Views قائمة في التاريخ تتطلب CREATE VIEW).
# التحويل: عند اعتماده يصبح DB_USER/DB_PASS = قيم ems_app؛ والمشغّل يستعمل زوج MIGRATOR.
DB_APP_USER=
DB_APP_PASS=
DB_MIGRATOR_USER=
DB_MIGRATOR_PASS=

# ── الإنفاذ المتدرج لحماية CSRF (ADR-05) ─────────────────────────────────────
# مسارات يُحجب فيها الطلب فعليًا عند فشل التحقق (والباقي وضع مراقبة/تسجيل).
# قيم مفصولة بفواصل تُطابَق كأجزاء من مسار السكربت. أمثلة:
#   CSRF_ENFORCE_PATHS=/Finance/                        ← وحدة كاملة
#   CSRF_ENFORCE_PATHS=/Finance/,/Transport/,/login.php ← عدة مسارات
# القاعدة: أي وحدة جديدة تُضاف هنا من يوم إطلاقها. التراجع = حذف المسار.
# عند التعميم الكامل يُقلب EMS_CSRF_ENFORCE=true في config.php.
CSRF_ENFORCE_PATHS=

# ── بوابة العزل TenantDb (ADR-02 · المرحلة 1 · K1) — نمط CSRF نفسه ──────────
# غياب المفتاح (أو enforce) = fail-closed صافٍ (الافتراض الآمن).
# monitor = حالات سياق العزل الثلاث (جدول غير مسجَّل/مقيَّد، لا شركة في السياق)
#   تُسجَّل tenant_gate_would_deny ثم تُمرَّر بسلوك ما قبل الهجرة (قراءة/إدراج فقط؛
#   الكتابات التعديلية والهجمات تُرفض دائمًا). يُستعمل أثناء الطرح التدريجي حصرًا.
# EMS_TENANT_GATE=monitor
# مسارات تُنفَذ fail-closed حتى في monitor (إنفاذ شاشةً شاشة — كنمط CSRF_ENFORCE_PATHS):
#   TENANT_ENFORCE_PATHS=/Opportunities/,/Procurement/
EMS_TENANT_GATE=
TENANT_ENFORCE_PATHS=

# ═══ REV-08 §5 — صمّام Fail-Closed للشاشات غير المسجَّلة (شاشات السايدبار فقط) ═══
# شاشةٌ لا تُحَلّ إلى موديول تحت بادئةٍ في قائمة الإنفاذ → 403 (UNREGISTERED_SCREEN_DENY)؛
# وتحت بادئةٍ في قائمة المراقبة → UNREGISTERED_SCREEN_WOULD_DENY بلا حجب (جردٌ قبل الإنفاذ).
# اترك الإنفاذ فارغًا حتى تُسجَّل الشاشات المسجَّلة بكودٍ قصير؛ المهلة تُرفَق بسطر الرصد.
EMS_FAILCLOSED_ENFORCE_PREFIXES=
EMS_FAILCLOSED_MONITOR_PREFIXES=
EMS_LEGACY_TRANSPARENCY_DEADLINE=

# ── حارس صلاحية الفعل لمعالجات AJAX (ADR-06) ─────────────────────────────────
# monitor = يسجّل ما كان سيُرفض دون حجب (افتراضي، للمراقبة قبل الإنفاذ).
# enforce = يرفض فعليًا (403) أي معالجٍ لا يملك المستخدم صلاحية فعله.
# التراجع: أعِده إلى monitor (بلا نشر كود).
EMS_ACTION_GUARD=monitor

# ── مفاتيح تشغيل مهام cron عبر المتصفح ───────────────────────────────────────
# التشغيل عبر CLI (جدولة النظام) لا يحتاج مفتاحًا. مسار الويب ?key=... يُرفض
# كليًا إذا كان المفتاح فارغًا هنا (fail-closed). أنشئ مفتاحًا عشوائيًا قويًا:
#   php -r "echo bin2hex(random_bytes(20));"
FINANCE_CRON_KEY=
TRANSPORT_CRON_KEY=

# مفتاح مهمة الحوكمة الزمنية لبوابة الطلبات المالية D05 (fail-closed: فارغ = لا مسار ويب)
REQUESTS_CRON_KEY=

# ── ناقل الأحداث المؤسسي (K3/K4/K5) ─────────────────────────────────────────
# EMS_EVENT_HOOKS: خطاف الدوام→المالية عند الاعتماد الرابع.
#   off (افتراضي) = خامل · monitor = تسجيل ما كان سيُنشر · publish = نشر فعلي.
EMS_EVENT_HOOKS=off
# مفتاح تشغيل cron_events عبر الويب (fail-closed: فارغ = CLI فقط)
EVENTS_CRON_KEY=

# ── الجذر المحايد ADR-15 (REV-04 §6.2) ──────────────────────────────────────
# off (افتراضي) = الناشر يكتب الدفتر المالي وحده (سلوك ما قبل الجذر حرفيًا).
# publish = كتابة مزدوجة ذرّية: الحقيقة في ems_business_events ثم إسقاطها المالي
#   في fin_financial_events مربوطًا بـroot_event_id — بنفس معاملة المصدر.
# التراجع الفوري: أعِده إلى off (بلا نشر كود؛ الصفوف المكتوبة تبقى سليمة).
EMS_EVENT_ROOT=off

# D02: بوابة التحويل المالي — on = لا يُولَّد مالٌ إلا بختم المالية
# off = السلوك القديم (المروحة تنطلق تلقائيًّا عند الاعتماد الرابع)
EMS_UNIT_CONVERT_GATE=off

# §9-③ (UX-03 §8): طور الكتابة المزدوجة — on = مرآةُ مسار timesheet الحي
# إلى السجل القانوني unit_entries بالتوازي (المال من المسار الحي حصرًا)
EMS_UNIT_DUAL_WRITE=off

# UX-03 §5.1: سطورُ الزمن في شاشة التايم شيت (الخادم يشتق الأعمدة التسعة منها)
EMS_TS_TIME_LINES=off

# §9-③ ④: مصدرُ قراءة المروحة — legal = من السجل القانوني حين توجد المرآة
EMS_UNIT_FANOUT_SOURCE=timesheet

# D02 §2.6: سلطةُ الحكم — من أين يأخذ المالُ كميتَه؟
# on  = من `qty_due` في unit_party_awards (سياسةُ العقد تسري على الفوترة فعلًا)
# off = من الكمية الخام المسجَّلة (السلوك السابق — الأحكام تُسجَّل ولا تحكم)
# قِيس قبل التفعيل على بيانات co4: 200 طرفًا قابلًا للتسعير · صفر فارق — لأن
# السياسة الافتراضية تحتسب التشغيل الفعلي كاملًا وتترك ما عداه بلا حكم. فالفارق
# لا يظهر إلا حين تُدخِل إدارةُ العقود سياسةً تحتسب الاستعداد أو توقف العميل.
# التراجع الفوري: أعِده إلى off (بلا نشر كود؛ الأحكام المكتوبة تبقى سليمة).
EMS_AWARD_AUTHORITY=on

# D02 §3.10: حارس الطاقة اليومية — «إعدادٌ لا ثابت»
# المعدة: ورديتان × 10 = 20 ساعةً مخططةً يوميًّا · المشغّل: وردية = 10
# التجاوز لا يُمنع إدخالُه (الإضافي والتسوية تجاوزٌ صحيح) — يُرفع العلم
# ويُمنع اعتمادُ الموقع حتى السبب والفحوص واعتماد المسؤول.
EMS_UNIT_CAPACITY_EQUIPMENT_HOURS=20
EMS_UNIT_CAPACITY_OPERATOR_HOURS=10
