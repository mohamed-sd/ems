# ═══════════════════════════════════════════════════════════════════════════
# EMS — قالب متغيرات البيئة (.env.example) · ADR-04
#
# طريقة الاستخدام: انسخ هذا الملف باسم .env في جذر المشروع واملأ القيم.
#   cp .env.example .env
# ملف .env الحقيقي لا يدخل المستودع أبدًا (محجوب في .gitignore).
# القاعدة: أي سرٍّ جديد يُضاف هنا كمفتاح موثَّق ويُقرأ بـ ems_env() —
# لا يُكتب أي سرٍّ في الكود إطلاقًا (قائمة التجميد · EQUIP-ARC-R02 §5).
# ═══════════════════════════════════════════════════════════════════════════

# ── قاعدة البيانات ──────────────────────────────────────────────────────────
# محليًا (WAMP): localhost / root / (فارغة) / equipation_manage
# على الإنتاج (Hostinger): القيم من hPanel → Databases
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# ── الإنفاذ المتدرج لحماية CSRF (ADR-05) ─────────────────────────────────────
# مسارات يُحجب فيها الطلب فعليًا عند فشل التحقق (والباقي وضع مراقبة/تسجيل).
# قيم مفصولة بفواصل تُطابَق كأجزاء من مسار السكربت. أمثلة:
#   CSRF_ENFORCE_PATHS=/Finance/                        ← وحدة كاملة
#   CSRF_ENFORCE_PATHS=/Finance/,/Transport/,/login.php ← عدة مسارات
# القاعدة: أي وحدة جديدة تُضاف هنا من يوم إطلاقها. التراجع = حذف المسار.
# عند التعميم الكامل يُقلب EMS_CSRF_ENFORCE=true في config.php.
CSRF_ENFORCE_PATHS=

# ── حارس صلاحية الفعل لمعالجات AJAX (ADR-06) ─────────────────────────────────
# monitor = يسجّل ما كان سيُرفض دون حجب (افتراضي، للمراقبة قبل الإنفاذ).
# enforce = يرفض فعليًا (403) أي معالجٍ لا يملك المستخدم صلاحية فعله.
# التراجع: أعِده إلى monitor (بلا نشر كود).
EMS_ACTION_GUARD=monitor

# ── مفاتيح تشغيل مهام cron عبر المتصفح ───────────────────────────────────────
# التشغيل عبر CLI (جدولة النظام) لا يحتاج مفتاحًا. مسار الويب ?key=... يُرفض
# كليًا إذا كان المفتاح فارغًا هنا (fail-closed). أنشئ مفتاحًا عشوائيًا قويًا:
#   php -r "echo bin2hex(random_bytes(20));"
FINANCE_CRON_KEY=
TRANSPORT_CRON_KEY=
